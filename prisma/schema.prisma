datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AssetEntryMethod {
  INITIAL_POSITION
  PURCHASE_CASH
  PURCHASE_FINANCED
  DONATION_INHERITANCE
  OTHER
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AssetAcquisitionMode {
  FULL_OWNERSHIP
  FINANCED
  EQUITY_BUILDUP
}

model User {
  id                    String            @id @default(uuid())
  name                  String
  email                 String            @unique
  controlStartDate      DateTime?         // Data-Base de início do controle financeiro
  onboardingStatus      OnboardingStatus  @default(NOT_STARTED)
  onboardingStep        Int               @default(1)
  onboardingCompletedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  accounts                Account[]
  assets                  Asset[]
  investmentPositions     InvestmentPosition[]
  investmentEvents        InvestmentEvent[]
  liabilities             Liability[]
  categories              Category[]
  transactions            Transaction[]
  netWorthSnapshots       NetWorthSnapshot[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  financialInstitutions   FinancialInstitution[]
  recurringRules          RecurringRule[]
  scheduledCommitments    ScheduledCommitment[]
}

model FinancialInstitution {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    // Banco do Brasil, Sicoob, Sicredi, Bradesco, Corretoras
  type      String?
  logoUrl   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts  Account[]
}

model Account {
  id                     String               @id @default(uuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialInstitutionId String?
  financialInstitution   FinancialInstitution? @relation(fields: [financialInstitutionId], references: [id])
  name                   String
  type                   String               // CHECKING, SAVINGS, CASH, BROKERAGE, INVESTMENT, OTHER
  
  // Controle de Saldos e Conciliação
  initialBalance         Decimal              @default(0) @db.Decimal(18, 4) // Saldo de Abertura na Data-Base
  calculatedBalance      Decimal              @default(0) @db.Decimal(18, 4) // Saldo Atual (Abertura + Movimentações)
  confirmedBalance       Decimal?             @db.Decimal(18, 4)             // Saldo informado pela instituição
  reconciliationDiff     Decimal              @default(0) @db.Decimal(18, 4) // confirmedBalance - calculatedBalance
  lastSyncAt             DateTime?
  
  currency               String               @default("BRL")
  creditCardClosingDay   Int?                 // 1..31; usado somente em cartões
  creditCardDueDay       Int?                 // 1..31; usado somente em cartões
  active                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  outgoingTransactions   Transaction[]        @relation("AccountTransactions")
  destinationTransfers   Transaction[]        @relation("TransferDestinationAccount")
  balanceSnapshots       AccountBalanceSnapshot[]
  investmentPositions    InvestmentPosition[]
  investmentEvents       InvestmentEvent[]
  recurringRules          RecurringRule[]
  scheduledCommitments    ScheduledCommitment[]
}

model Instrument {
  id             String         @id @default(uuid())
  symbol         String?        // ex: PETR4, HGLG11, TESOURO_SELIC_2029
  name           String         // ex: Petrobras PN, Tesouro Selic 2029
  instrumentType String         // STOCK, FII, BDR, ETF, TREASURY_BOND, INVESTMENT_FUND, FIXED_INCOME, CRYPTO, OTHER
  isin           String?
  currency       String         @default("BRL")
  exchange       String?        // B3, NYSE, NASDAQ, MANUAL
  externalId     String?
  source         String         @default("MANUAL")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  positions      InvestmentPosition[]

  @@unique([source, externalId])
  @@unique([symbol, exchange])
}

model InvestmentPosition {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String      // Conta de custódia (Corretora ou Banco)
  account          Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId     String
  instrument       Instrument  @relation(fields: [instrumentId], references: [id])
  
  quantity         Decimal?    @db.Decimal(18, 6) // Opcional (QUANTITY_BASED vs VALUE_BASED)
  averageCost      Decimal?    @db.Decimal(18, 4)
  currentPrice     Decimal?    @db.Decimal(18, 4)
  currentValue     Decimal     @db.Decimal(18, 4)
  acquisitionValue Decimal     @db.Decimal(18, 4)
  lastPriceAt      DateTime?
  
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  events           InvestmentEvent[]
  snapshots        InvestmentPositionSnapshot[]
}

model InvestmentEvent {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentPositionId String
  investmentPosition   InvestmentPosition  @relation(fields: [investmentPositionId], references: [id], onDelete: Cascade)
  accountId            String?             // Conta que recebeu o dinheiro
  account              Account?            @relation(fields: [accountId], references: [id])
  transactionId        String?
  transaction          Transaction?        @relation(fields: [transactionId], references: [id])
  type                 String              // INITIAL_POSITION, CONTRIBUTION, WITHDRAWAL, INCOME_RECEIVED, DIVIDEND, JCP, APPRECIATION, DEPRECIATION, REALIZED_GAIN
  date                 DateTime            @default(now())
  amount               Decimal             @db.Decimal(18, 4)
  quantity             Decimal?            @db.Decimal(18, 6)
  unitPrice            Decimal?            @db.Decimal(18, 4)
  notes                String?
  source               String              @default("MANUAL")
  externalId           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model InvestmentPositionSnapshot {
  id                   String             @id @default(uuid())
  investmentPositionId String
  investmentPosition   InvestmentPosition @relation(fields: [investmentPositionId], references: [id], onDelete: Cascade)
  date                 DateTime           @default(now())
  quantity             Decimal?           @db.Decimal(18, 6)
  unitPrice            Decimal?           @db.Decimal(18, 4)
  currentValue         Decimal            @db.Decimal(18, 4)
  source               String             @default("MANUAL")
  createdAt            DateTime           @default(now())
}

model Asset {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String               // ex: Apartamento Jardins, Toyota Corolla
  category             String               // REAL_ESTATE, VEHICLE, EQUIPMENT, CORPORATE_SHARE, OTHER
  entryMethod          AssetEntryMethod     @default(INITIAL_POSITION) // ÚNICA FONTE DE VERDADE PARA TIPO DE ENTRADA
  acquisitionMode      AssetAcquisitionMode @default(FULL_OWNERSHIP)
  description          String?
  acquisitionDate      DateTime?
  acquisitionValue     Decimal              @db.Decimal(18, 4)
  paidEquityValue      Decimal?             @db.Decimal(18, 4) // Valor integralizado/pago até o momento (para EQUITY_BUILDUP)
  currentValue         Decimal              @db.Decimal(18, 4) // Valor de mercado estimado atual do bem
  lastValuationDate    DateTime             @default(now())
  notes                String?
  active               Boolean           @default(true)
  considerInNetWorth   Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  valuations           AssetValuation[]
  liabilities          Liability[]       // Dívidas associadas (ex: financiamento imobiliário)
  allocations          TransactionAllocation[]
}

model AssetValuation {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  value       Decimal  @db.Decimal(18, 4)
  source      String   @default("MANUAL")
  notes       String?
  createdAt   DateTime @default(now())
}

model Liability {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String        // Financiamento CEF Apt 302
  institution           String?       // Caixa Econômica Federal
  type                  String        // MORTGAGE, VEHICLE_LOAN, PERSONAL_LOAN, INSTALLMENT, CREDIT_CARD, OTHER
  originalValue         Decimal       @db.Decimal(18, 4)
  currentBalance        Decimal       @db.Decimal(18, 4) // Saldo devedor atual
  startDate             DateTime?
  interestRate          Decimal?      @db.Decimal(8, 4)  // Taxa de juros ao ano/mês
  totalInstallments     Int?
  remainingInstallments Int?
  installmentValue      Decimal?      @db.Decimal(18, 4)
  associatedAssetId     String?
  associatedAsset       Asset?        @relation(fields: [associatedAssetId], references: [id])
  isInitialPosition     Boolean       @default(true)
  active                Boolean       @default(true)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  allocations           TransactionAllocation[]
}

model Category {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String?
  color         String?
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryHierarchy")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  transactions Transaction[]
  allocations  TransactionAllocation[]
  recurringRules RecurringRule[]
  scheduledCommitments ScheduledCommitment[]
}

model Transaction {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  account              Account              @relation("AccountTransactions", fields: [accountId], references: [id])
  destinationAccountId String?              // Preenchido em caso de transferência
  destinationAccount   Account?             @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id])
  date                 DateTime             @default(now())
  description          String
  amount               Decimal              @db.Decimal(18, 4)
  direction            String               // CREDIT, DEBIT
  transactionType      String               // INCOME, EXPENSE, TRANSFER, ASSET_PURCHASE, etc.
  categoryId           String?
  category             Category?            @relation(fields: [categoryId], references: [id])
  cardInvoiceKey       String?              // Ex.: 2026-08; fatura a que pertence a compra/pagamento
  notes                String?
  
  // Idempotência e Integrações Futuras
  source               String               @default("MANUAL")
  externalId           String?
  importHash           String?              // Hash para deduplicação em cargas OFX/CSV/APIs
  syncTimestamp        DateTime?

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  allocations          TransactionAllocation[]
  investmentEvents     InvestmentEvent[]

  @@unique([userId, accountId, externalId])
  @@unique([userId, accountId, importHash])
  @@index([userId, cardInvoiceKey])
}

model TransactionAllocation {
  id             String         @id @default(uuid())
  transactionId  String
  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  allocationType String         // EXPENSE, INCOME, ASSET_INCREASE, ASSET_DECREASE, etc.
  amount         Decimal        @db.Decimal(18, 4)
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  assetId        String?
  asset          Asset?         @relation(fields: [assetId], references: [id])
  liabilityId    String?
  liability      Liability?     @relation(fields: [liabilityId], references: [id])
  notes          String?
  createdAt      DateTime       @default(now())
}

model AccountBalanceSnapshot {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date              DateTime @default(now())
  calculatedBalance Decimal  @db.Decimal(18, 4)
  confirmedBalance  Decimal? @db.Decimal(18, 4)
  createdAt         DateTime @default(now())

  @@unique([accountId, date])
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  liquidAssets     Decimal  @db.Decimal(18, 4) // Contas correntes + caixa
  investmentAssets Decimal  @db.Decimal(18, 4) // Ativos de investimento
  physicalAssets   Decimal  @db.Decimal(18, 4) // Imóveis, veículos, etc.
  totalAssets      Decimal  @db.Decimal(18, 4) // Soma dos ativos
  totalLiabilities Decimal  @db.Decimal(18, 4) // Soma dos passivos
  netWorth         Decimal  @db.Decimal(18, 4) // totalAssets - totalLiabilities
  liquidNetWorth   Decimal? @db.Decimal(18, 4) // Ativos líquidos + investimentos - dívidas CP
  createdAt        DateTime @default(now())
}


model RecurringRule {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  account              Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             Category?            @relation(fields: [categoryId], references: [id])
  description          String
  amount               Decimal              @db.Decimal(18, 4)
  frequency            String               @default("MONTHLY")
  startDate            DateTime
  endDate              DateTime?
  active               Boolean              @default(true)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  scheduledCommitments ScheduledCommitment[]
}

model ScheduledCommitment {
  id                   String          @id @default(uuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  account              Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             Category?       @relation(fields: [categoryId], references: [id])
  recurringRuleId      String?
  recurringRule        RecurringRule?  @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)
  description          String
  amount               Decimal         @db.Decimal(18, 4)
  dueDate              DateTime
  status               String          @default("PENDING") // PENDING, POSTED, SKIPPED
  sourceType           String          // RECURRING, INSTALLMENT
  groupId              String?
  installmentNumber    Int?
  totalInstallments    Int?
  transactionId        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([recurringRuleId, dueDate])
  @@index([userId, status, dueDate])
}

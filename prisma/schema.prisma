datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts                Account[]
  assets                  Asset[]
  investmentPositions     InvestmentPosition[]
  investmentEvents        InvestmentEvent[]
  liabilities             Liability[]
  categories              Category[]
  transactions            Transaction[]
  netWorthSnapshots       NetWorthSnapshot[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  financialInstitutions   FinancialInstitution[]
}

model FinancialInstitution {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    // Banco do Brasil, Sicoob, Sicredi, Bradesco, Corretoras
  type      String?
  logoUrl   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts  Account[]
}

model Account {
  id                     String               @id @default(uuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialInstitutionId String?
  financialInstitution   FinancialInstitution? @relation(fields: [financialInstitutionId], references: [id])
  name                   String
  type                   String               // CHECKING, SAVINGS, CASH, BROKERAGE, INVESTMENT, OTHER
  
  // Controle de Saldos e Conciliação
  initialBalance         Decimal              @default(0)
  calculatedBalance      Decimal              @default(0) // Derivado das transações
  confirmedBalance       Decimal?                         // Saldo informado pela instituição
  reconciliationDiff     Decimal              @default(0) // confirmedBalance - calculatedBalance
  lastSyncAt             DateTime?
  
  currency               String               @default("BRL")
  active                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  outgoingTransactions   Transaction[]        @relation("AccountTransactions")
  destinationTransfers   Transaction[]        @relation("TransferDestinationAccount")
  balanceSnapshots       AccountBalanceSnapshot[]
  investmentPositions    InvestmentPosition[]
  investmentEvents       InvestmentEvent[]
}

model Instrument {
  id             String         @id @default(uuid())
  symbol         String?        // ex: PETR4, HGLG11, TESOURO_SELIC_2029
  name           String         // ex: Petrobras PN, Tesouro Selic 2029
  instrumentType String         // STOCK, FII, BDR, ETF, TREASURY_BOND, INVESTMENT_FUND, FIXED_INCOME, CRYPTO, OTHER
  isin           String?
  currency       String         @default("BRL")
  exchange       String?        // B3, NYSE, NASDAQ, MANUAL
  externalId     String?
  source         String         @default("MANUAL")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  positions      InvestmentPosition[]
}

model InvestmentPosition {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String      // Conta de custódia (Corretora ou Banco)
  account          Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrumentId     String
  instrument       Instrument  @relation(fields: [instrumentId], references: [id])
  
  quantity         Decimal?
  averageCost      Decimal?
  currentPrice     Decimal?
  currentValue     Decimal
  acquisitionValue Decimal
  lastPriceAt      DateTime?
  
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  events           InvestmentEvent[]
  snapshots        InvestmentPositionSnapshot[]
}

model InvestmentEvent {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentPositionId String
  investmentPosition   InvestmentPosition  @relation(fields: [investmentPositionId], references: [id], onDelete: Cascade)
  accountId            String?             // Conta que recebeu o dinheiro
  account              Account?            @relation(fields: [accountId], references: [id])
  transactionId        String?
  transaction          Transaction?        @relation(fields: [transactionId], references: [id])
  type                 String              // INITIAL_POSITION, CONTRIBUTION, WITHDRAWAL, INCOME_RECEIVED, DIVIDEND, JCP, APPRECIATION, DEPRECIATION, REALIZED_GAIN
  date                 DateTime            @default(now())
  amount               Decimal
  quantity             Decimal?
  unitPrice            Decimal?
  notes                String?
  source               String              @default("MANUAL")
  externalId           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model InvestmentPositionSnapshot {
  id                   String             @id @default(uuid())
  investmentPositionId String
  investmentPosition   InvestmentPosition @relation(fields: [investmentPositionId], references: [id], onDelete: Cascade)
  date                 DateTime           @default(now())
  quantity             Decimal?
  unitPrice            Decimal?
  currentValue         Decimal
  source               String             @default("MANUAL")
  createdAt            DateTime           @default(now())
}

model Asset {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String            // ex: Apartamento Jardins, Toyota Corolla
  category             String            // REAL_ESTATE, VEHICLE, EQUIPMENT, CORPORATE_SHARE, OTHER
  description          String?
  acquisitionDate      DateTime?
  acquisitionValue     Decimal
  currentValue         Decimal
  lastValuationDate    DateTime          @default(now())
  notes                String?
  active               Boolean           @default(true)
  considerInNetWorth   Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  valuations           AssetValuation[]
  liabilities          Liability[]       // Dívidas associadas
  allocations          TransactionAllocation[]
}

model AssetValuation {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  value       Decimal
  source      String   @default("MANUAL")
  notes       String?
  createdAt   DateTime @default(now())
}

model Liability {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String        // Financiamento CEF Apt 302
  institution           String?       // Caixa Econômica Federal
  type                  String        // MORTGAGE, VEHICLE_LOAN, PERSONAL_LOAN, INSTALLMENT, CREDIT_CARD, OTHER
  originalValue         Decimal
  currentBalance        Decimal       // Saldo devedor atual
  startDate             DateTime?
  interestRate          Decimal?      // Taxa de juros ao ano/mês
  totalInstallments     Int?
  remainingInstallments Int?
  installmentValue      Decimal?
  associatedAssetId     String?
  associatedAsset       Asset?        @relation(fields: [associatedAssetId], references: [id])
  active                Boolean       @default(true)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  allocations           TransactionAllocation[]
}

model Category {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String?
  color         String?
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryHierarchy")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  transactions Transaction[]
  allocations  TransactionAllocation[]
}

model Transaction {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  account              Account              @relation("AccountTransactions", fields: [accountId], references: [id])
  destinationAccountId String?              // Preenchido em caso de transferência
  destinationAccount   Account?             @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id])
  date                 DateTime             @default(now())
  description          String
  amount               Decimal
  direction            String               // CREDIT, DEBIT
  transactionType      String               // INCOME, EXPENSE, TRANSFER, etc.
  categoryId           String?
  category             Category?            @relation(fields: [categoryId], references: [id])
  notes                String?
  
  // Idempotência e Integrações Futuras
  source               String               @default("MANUAL")
  externalId           String?
  importHash           String?              // Hash para deduplicação em cargas OFX/CSV/APIs
  syncTimestamp        DateTime?

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  allocations          TransactionAllocation[]
  investmentEvents     InvestmentEvent[]

  @@unique([userId, accountId, externalId])
  @@unique([userId, accountId, importHash])
}

model TransactionAllocation {
  id             String         @id @default(uuid())
  transactionId  String
  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  allocationType String         // EXPENSE, INCOME, ASSET_INCREASE, ASSET_DECREASE, etc.
  amount         Decimal
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  assetId        String?
  asset          Asset?         @relation(fields: [assetId], references: [id])
  liabilityId    String?
  liability      Liability?     @relation(fields: [liabilityId], references: [id])
  notes          String?
  createdAt      DateTime       @default(now())
}

model AccountBalanceSnapshot {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date              DateTime @default(now())
  calculatedBalance Decimal
  confirmedBalance  Decimal?
  createdAt         DateTime @default(now())

  @@unique([accountId, date])
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  liquidAssets     Decimal  // Contas correntes + caixa
  investmentAssets Decimal  // Ativos de investimento
  physicalAssets   Decimal  // Imóveis, veículos, etc.
  totalAssets      Decimal  // Soma dos ativos
  totalLiabilities Decimal  // Soma dos passivos
  netWorth         Decimal  // totalAssets - totalLiabilities
  liquidNetWorth   Decimal? // Ativos líquidos + investimentos - dívidas CP
  createdAt        DateTime @default(now())
}
